# Copiez ce fichier vers .env.local et renseignez vos propres valeurs.
# Trouvables dans Supabase > Project Settings > API

# Utilisées par le site (safe à exposer côté navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Utilisées UNIQUEMENT en local par le script d'import (scripts/seed.mjs)
# Ne jamais renseigner ces valeurs sur Vercel / dans un déploiement public.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
